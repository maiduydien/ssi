# Replay engine: max ticks processed per 500ms pulse (tune for CPU/STOP responsiveness)
REPLAY_BATCH_TICKS=10000
# Minimum interval between full Plotly figure updates, except when a new candle begins
CHART_REFRESH_SECONDS=1.25
